{
  "name": "lalaba-customer-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node start.js --dev-client",
    "android": "expo run:android --no-install",
    "ios": "expo run:ios --no-install",
    "type-check": "tsc --noEmit",
    "lint": "eslint src app --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/react-native/matchers",
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-maps|lucide-react-native|zustand|firebase|@firebase)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/app-check": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "~55.0.26",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-font": "55.0.8",
    "expo-image-picker": "~55.0.21",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.28",
    "firebase": "10.14.1",
    "lucide-react-native": "^0.462.0",
    "nativewind": "4.2.3",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "2.30.1",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "zod": "^4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "autoprefixer": "10.4.19",
    "babel-preset-expo": "~55.0.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "postcss": "8.4.38",
    "react-refresh": "^0.18.0",
    "tailwindcss": "3.4.0",
    "typescript": "~5.9.2"
  }
}
